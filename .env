# ========================================
# 🛂 VISA CHECKER - ENVIRONMENT VARIABLES
# ========================================

# ========== SERVER ==========
PORT=5000
NODE_ENV=development

# ========== DATABASE ==========
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=visa_db

# ========== CORS ==========
CORS_ORIGIN=*

# ========== FOR PRODUCTION (Heroku/Railway) ==========
# DATABASE_URL=postgresql://user:password@host:port/database
# PORT=process.env.PORT

# ========== NOTES ==========
# 1. Change DB_PASSWORD to your PostgreSQL password
# 2. For Heroku, use DATABASE_URL instead of individual DB_* variables
# 3. Update CORS_ORIGIN to your frontend URL in production
